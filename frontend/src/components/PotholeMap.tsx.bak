const SUPABASE_URL = "https://rcflhgcfmqueyqhcqtii.supabase.co";
const SUPABASE_KEY = "sb_publishable_Qz4eTWnLQPTTS1Bc3nPXEA_6j5u12X0";
const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
